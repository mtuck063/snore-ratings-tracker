.DS_Store

# Apple Ads session cookie for scripts/popularity.mjs, if you keep it in a file
# rather than typing it. It is a live credential: committing it hands anyone
# reading the repo your Apple Ads session.
.env
.asa-cookie

# App Store Connect analytics stay local. The data is the business ledger
# (impressions, downloads, deletions by day and country) and the report script
# carries real figures in its comments; neither belongs in a public repo.
docs/data/asc/
scripts/asc-reports.mjs
